// Checked proofs; prerequisites are imported by subject.
import "foundation/equality.tp";

theorem eq_cong (f : U -> U) (a b : U) (h : Prf (Eq a b))
  : Prf (Eq (f a) (f b))
  := eq_subst (fun (x : U) => Eq (f a) (f x)) a b h (eq_refl (f a));

theorem eq_sym (a b : U) (h : Prf (Eq a b)) : Prf (Eq b a)
  := eq_subst (fun (x : U) => Eq x a) a b h (eq_refl a);

theorem eq_trans (a b c : U) (h : Prf (Eq a b)) (k : Prf (Eq b c))
  : Prf (Eq a c) := eq_subst (fun (x : U) => Eq a x) b c k h;
