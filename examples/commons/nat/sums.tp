// Checked proofs; prerequisites are imported by subject.
import "../foundation/sums.tp";
import "multiplication.tp";
import "order.tp";

theorem sum_between_prefix (n : Nat) (f : Nat -> Nat) : Prf (Eq (sum_between zero (succ n) f) (sum n (fun (k
    : Nat) => f (succ k))))
  := all_seq_elim (fun (f : Nat -> Nat) => (Eq (sum_between zero (succ n) f) (sum n (fun (k : Nat) => f
    (succ k))))) (nat_induction (fun (x : Nat) => (AllSeq (fun (f : Nat -> Nat) => (Eq (sum_between zero
    (succ x) f) (sum x (fun (k : Nat) => f (succ k))))))) (all_seq_intro (fun (f : Nat -> Nat) => (Eq
    (sum_between zero (succ zero) f) (sum zero (fun (k : Nat) => f (succ k))))) (fun (f : Nat -> Nat) =>
    eq_trans (sum_between zero (succ zero) f) zero (sum zero (fun (k : Nat) => f (succ k))) (eq_trans
    (sum_between zero (succ zero) f) (sum_between zero zero f) zero (sum_between_succ_outside zero zero f
    (not_intro (Lt zero zero) lt_zero_irrefl)) (sum_between_zero zero f)) (eq_sym (sum zero (fun (k : Nat)
    => f (succ k))) zero (sum_zero (fun (k : Nat) => f (succ k)))))) (fun (x : Nat) (ih : Prf (AllSeq (fun
    (f : Nat -> Nat) => (Eq (sum_between zero (succ x) f) (sum x (fun (k : Nat) => f (succ k))))))) =>
    all_seq_intro (fun (f : Nat -> Nat) => (Eq (sum_between zero (succ (succ x)) f) (sum (succ x) (fun (k :
    Nat) => f (succ k))))) (fun (f : Nat -> Nat) => eq_trans (sum_between zero (succ (succ x)) f) (add (sum
    x (fun (k : Nat) => f (succ k))) (f (succ x))) (sum (succ x) (fun (k : Nat) => f (succ k))) (eq_trans
    (sum_between zero (succ (succ x)) f) (add (sum_between zero (succ x) f) (f (succ x))) (add (sum x (fun
    (k : Nat) => f (succ k))) (f (succ x))) (sum_between_succ_inside zero (succ x) f (zero_lt_succ x))
    (eq_cong (fun (z : Nat) => (add z (f (succ x)))) (sum_between zero (succ x) f) (sum x (fun (k : Nat) =>
    f (succ k))) ((all_seq_elim (fun (f : Nat -> Nat) => (Eq (sum_between zero (succ x) f) (sum x (fun (k :
    Nat) => f (succ k))))) (ih) f)))) (eq_sym (sum (succ x) (fun (k : Nat) => f (succ k))) (add (sum x (fun
    (k : Nat) => f (succ k))) (f (succ x))) (sum_succ x (fun (k : Nat) => f (succ k)))))) n) f;

theorem sum_shift (n : Nat) (f : Nat -> Nat) : Prf (Eq (sum (succ n) f) (add (f zero) (sum n (fun (k : Nat)
    => f (succ k)))))
  := all_seq_elim (fun (f : Nat -> Nat) => (Eq (sum (succ n) f) (add (f zero) (sum n (fun (k : Nat) => f
    (succ k)))))) (nat_induction (fun (x : Nat) => (AllSeq (fun (f : Nat -> Nat) => (Eq (sum (succ x) f)
    (add (f zero) (sum x (fun (k : Nat) => f (succ k)))))))) (all_seq_intro (fun (f : Nat -> Nat) => (Eq
    (sum (succ zero) f) (add (f zero) (sum zero (fun (k : Nat) => f (succ k)))))) (fun (f : Nat -> Nat) =>
    eq_trans (sum (succ zero) f) (add (f zero) zero) (add (f zero) (sum zero (fun (k : Nat) => f (succ k))))
    (eq_trans (sum (succ zero) f) (f zero) (add (f zero) zero) (eq_trans (sum (succ zero) f) (add zero (f
    zero)) (f zero) (eq_trans (sum (succ zero) f) (add (sum zero f) (f zero)) (add zero (f zero)) (sum_succ
    zero f) (eq_cong (fun (z : Nat) => (add z (f zero))) (sum zero f) zero (sum_zero f))) (add_zero (f
    zero))) (eq_sym (add (f zero) zero) (f zero) (add_zero_right (f zero)))) (eq_sym (add (f zero) (sum zero
    (fun (k : Nat) => f (succ k)))) (add (f zero) zero) (eq_cong (fun (z : Nat) => (add (f zero) z)) (sum
    zero (fun (k : Nat) => f (succ k))) zero (sum_zero (fun (k : Nat) => f (succ k))))))) (fun (x : Nat) (ih
    : Prf (AllSeq (fun (f : Nat -> Nat) => (Eq (sum (succ x) f) (add (f zero) (sum x (fun (k : Nat) => f
    (succ k)))))))) => all_seq_intro (fun (f : Nat -> Nat) => (Eq (sum (succ (succ x)) f) (add (f zero) (sum
    (succ x) (fun (k : Nat) => f (succ k)))))) (fun (f : Nat -> Nat) => eq_trans (sum (succ (succ x)) f)
    (add (f zero) (add (sum x (fun (k : Nat) => f (succ k))) (f (succ x)))) (add (f zero) (sum (succ x) (fun
    (k : Nat) => f (succ k)))) (eq_trans (sum (succ (succ x)) f) (add (add (f zero) (sum x (fun (k : Nat) =>
    f (succ k)))) (f (succ x))) (add (f zero) (add (sum x (fun (k : Nat) => f (succ k))) (f (succ x))))
    (eq_trans (sum (succ (succ x)) f) (add (sum (succ x) f) (f (succ x))) (add (add (f zero) (sum x (fun (k
    : Nat) => f (succ k)))) (f (succ x))) (sum_succ (succ x) f) (eq_cong (fun (z : Nat) => (add z (f (succ
    x)))) (sum (succ x) f) (add (f zero) (sum x (fun (k : Nat) => f (succ k)))) ((all_seq_elim (fun (f : Nat
    -> Nat) => (Eq (sum (succ x) f) (add (f zero) (sum x (fun (k : Nat) => f (succ k)))))) (ih) f))))
    (add_assoc (f zero) (sum x (fun (k : Nat) => f (succ k))) (f (succ x)))) (eq_cong (fun (z : Nat) => (add
    (f zero) z)) (add (sum x (fun (k : Nat) => f (succ k))) (f (succ x))) (sum (succ x) (fun (k : Nat) => f
    (succ k))) (eq_sym (sum (succ x) (fun (k : Nat) => f (succ k))) (add (sum x (fun (k : Nat) => f (succ
    k))) (f (succ x))) (sum_succ x (fun (k : Nat) => f (succ k))))))) n) f;

theorem sum_add (n : Nat) (f g : Nat -> Nat) : Prf (Eq (sum n (fun (k : Nat) => add (f k) (g k))) (add (sum
    n f) (sum n g)))
  := all_seq_elim (fun (g : Nat -> Nat) => (Eq (sum n (fun (k : Nat) => add (f k) (g k))) (add (sum n f)
    (sum n g)))) (all_seq_elim (fun (f : Nat -> Nat) => (AllSeq (fun (g : Nat -> Nat) => (Eq (sum n (fun (k
    : Nat) => add (f k) (g k))) (add (sum n f) (sum n g)))))) (nat_induction (fun (x : Nat) => (AllSeq (fun
    (f : Nat -> Nat) => (AllSeq (fun (g : Nat -> Nat) => (Eq (sum x (fun (k : Nat) => add (f k) (g k))) (add
    (sum x f) (sum x g)))))))) (all_seq_intro (fun (f : Nat -> Nat) => (AllSeq (fun (g : Nat -> Nat) => (Eq
    (sum zero (fun (k : Nat) => add (f k) (g k))) (add (sum zero f) (sum zero g)))))) (fun (f : Nat -> Nat)
    => all_seq_intro (fun (g : Nat -> Nat) => (Eq (sum zero (fun (k : Nat) => add (f k) (g k))) (add (sum
    zero f) (sum zero g)))) (fun (g : Nat -> Nat) => eq_trans (sum zero (fun (k : Nat) => add (f k) (g k)))
    (add (sum zero f) zero) (add (sum zero f) (sum zero g)) (eq_trans (sum zero (fun (k : Nat) => add (f k)
    (g k))) (add zero zero) (add (sum zero f) zero) (eq_trans (sum zero (fun (k : Nat) => add (f k) (g k)))
    zero (add zero zero) (sum_zero (fun (k : Nat) => add (f k) (g k))) (eq_sym (add zero zero) zero
    (add_zero zero))) (eq_sym (add (sum zero f) zero) (add zero zero) (eq_cong (fun (z : Nat) => (add z
    zero)) (sum zero f) zero (sum_zero f)))) (eq_sym (add (sum zero f) (sum zero g)) (add (sum zero f) zero)
    (eq_cong (fun (z : Nat) => (add (sum zero f) z)) (sum zero g) zero (sum_zero g)))))) (fun (x : Nat) (ih
    : Prf (AllSeq (fun (f : Nat -> Nat) => (AllSeq (fun (g : Nat -> Nat) => (Eq (sum x (fun (k : Nat) => add
    (f k) (g k))) (add (sum x f) (sum x g)))))))) => all_seq_intro (fun (f : Nat -> Nat) => (AllSeq (fun (g
    : Nat -> Nat) => (Eq (sum (succ x) (fun (k : Nat) => add (f k) (g k))) (add (sum (succ x) f) (sum (succ
    x) g)))))) (fun (f : Nat -> Nat) => all_seq_intro (fun (g : Nat -> Nat) => (Eq (sum (succ x) (fun (k :
    Nat) => add (f k) (g k))) (add (sum (succ x) f) (sum (succ x) g)))) (fun (g : Nat -> Nat) => eq_trans
    (sum (succ x) (fun (k : Nat) => add (f k) (g k))) (add (sum (succ x) f) (add (sum x g) (g x))) (add (sum
    (succ x) f) (sum (succ x) g)) (eq_trans (sum (succ x) (fun (k : Nat) => add (f k) (g k))) (add (add (sum
    x f) (f x)) (add (sum x g) (g x))) (add (sum (succ x) f) (add (sum x g) (g x))) (eq_trans (sum (succ x)
    (fun (k : Nat) => add (f k) (g k))) (add (add (sum x f) (sum x g)) (add (f x) (g x))) (add (add (sum x
    f) (f x)) (add (sum x g) (g x))) (eq_trans (sum (succ x) (fun (k : Nat) => add (f k) (g k))) (add (sum x
    (fun (k : Nat) => add (f k) (g k))) (add (f x) (g x))) (add (add (sum x f) (sum x g)) (add (f x) (g x)))
    (sum_succ x (fun (k : Nat) => add (f k) (g k))) (eq_cong (fun (z : Nat) => (add z (add (f x) (g x))))
    (sum x (fun (k : Nat) => add (f k) (g k))) (add (sum x f) (sum x g)) ((all_seq_elim (fun (g : Nat ->
    Nat) => (Eq (sum x (fun (k : Nat) => add (f k) (g k))) (add (sum x f) (sum x g)))) (all_seq_elim (fun (f
    : Nat -> Nat) => (AllSeq (fun (g : Nat -> Nat) => (Eq (sum x (fun (k : Nat) => add (f k) (g k))) (add
    (sum x f) (sum x g)))))) (ih) f) g)))) (add_interchange (sum x f) (sum x g) (f x) (g x))) (eq_cong (fun
    (z : Nat) => (add z (add (sum x g) (g x)))) (add (sum x f) (f x)) (sum (succ x) f) (eq_sym (sum (succ x)
    f) (add (sum x f) (f x)) (sum_succ x f)))) (eq_cong (fun (z : Nat) => (add (sum (succ x) f) z)) (add
    (sum x g) (g x)) (sum (succ x) g) (eq_sym (sum (succ x) g) (add (sum x g) (g x)) (sum_succ x g)))))) n)
    f) g;

theorem sum_ext_rule (n : Nat) (f g : Nat -> Nat) : Prf (Imp (AllNat (fun (k : Nat) => (Eq (f k) (g k))))
    (Eq (sum n f) (sum n g)))
  := all_seq_elim (fun (g : Nat -> Nat) => (Imp (AllNat (fun (k : Nat) => (Eq (f k) (g k)))) (Eq (sum n f)
    (sum n g)))) (all_seq_elim (fun (f : Nat -> Nat) => (AllSeq (fun (g : Nat -> Nat) => (Imp (AllNat (fun
    (k : Nat) => (Eq (f k) (g k)))) (Eq (sum n f) (sum n g)))))) (nat_induction (fun (x : Nat) => (AllSeq
    (fun (f : Nat -> Nat) => (AllSeq (fun (g : Nat -> Nat) => (Imp (AllNat (fun (k : Nat) => (Eq (f k) (g
    k)))) (Eq (sum x f) (sum x g)))))))) (all_seq_intro (fun (f : Nat -> Nat) => (AllSeq (fun (g : Nat ->
    Nat) => (Imp (AllNat (fun (k : Nat) => (Eq (f k) (g k)))) (Eq (sum zero f) (sum zero g)))))) (fun (f :
    Nat -> Nat) => all_seq_intro (fun (g : Nat -> Nat) => (Imp (AllNat (fun (k : Nat) => (Eq (f k) (g k))))
    (Eq (sum zero f) (sum zero g)))) (fun (g : Nat -> Nat) => imp_intro (AllNat (fun (k : Nat) => (Eq (f k)
    (g k)))) (Eq (sum zero f) (sum zero g)) (fun (h : Prf (AllNat (fun (k : Nat) => (Eq (f k) (g k))))) =>
    eq_trans (sum zero f) zero (sum zero g) (sum_zero f) (eq_sym (sum zero g) zero (sum_zero g)))))) (fun (x
    : Nat) (ih : Prf (AllSeq (fun (f : Nat -> Nat) => (AllSeq (fun (g : Nat -> Nat) => (Imp (AllNat (fun (k
    : Nat) => (Eq (f k) (g k)))) (Eq (sum x f) (sum x g)))))))) => all_seq_intro (fun (f : Nat -> Nat) =>
    (AllSeq (fun (g : Nat -> Nat) => (Imp (AllNat (fun (k : Nat) => (Eq (f k) (g k)))) (Eq (sum (succ x) f)
    (sum (succ x) g)))))) (fun (f : Nat -> Nat) => all_seq_intro (fun (g : Nat -> Nat) => (Imp (AllNat (fun
    (k : Nat) => (Eq (f k) (g k)))) (Eq (sum (succ x) f) (sum (succ x) g)))) (fun (g : Nat -> Nat) =>
    imp_intro (AllNat (fun (k : Nat) => (Eq (f k) (g k)))) (Eq (sum (succ x) f) (sum (succ x) g)) (fun (h :
    Prf (AllNat (fun (k : Nat) => (Eq (f k) (g k))))) => eq_trans (sum (succ x) f) (add (sum x g) (g x))
    (sum (succ x) g) (eq_trans (sum (succ x) f) (add (sum x g) (f x)) (add (sum x g) (g x)) (eq_trans (sum
    (succ x) f) (add (sum x f) (f x)) (add (sum x g) (f x)) (sum_succ x f) (eq_cong (fun (z : Nat) => (add z
    (f x))) (sum x f) (sum x g) ((imp_elim (AllNat (fun (k : Nat) => (Eq (f k) (g k)))) (Eq (sum x f) (sum x
    g)) (all_seq_elim (fun (g : Nat -> Nat) => (Imp (AllNat (fun (k : Nat) => (Eq (f k) (g k)))) (Eq (sum x
    f) (sum x g)))) (all_seq_elim (fun (f : Nat -> Nat) => (AllSeq (fun (g : Nat -> Nat) => (Imp (AllNat
    (fun (k : Nat) => (Eq (f k) (g k)))) (Eq (sum x f) (sum x g)))))) (ih) f) g) h)))) (eq_cong (fun (z :
    Nat) => (add (sum x g) z)) (f x) (g x) (all_nat_elim (fun (k : Nat) => (Eq (f k) (g k))) h x))) (eq_sym
    (sum (succ x) g) (add (sum x g) (g x)) (sum_succ x g)))))) n) f) g;

theorem sum_ext (n : Nat) (f g : Nat -> Nat) (h : forall (k : Nat), Prf (Eq (f k) (g k)))
  : Prf (Eq (sum n f) (sum n g))
  := imp_elim (AllNat (fun (k : Nat) => (Eq (f k) (g k)))) (Eq (sum n f) (sum n g)) (sum_ext_rule n f g)
    (all_nat_intro (fun (k : Nat) => Eq (f k) (g k)) h);

theorem triangular_double (n : Nat) : Prf (Eq (mul (succ (succ zero)) (triangular n)) (mul n (succ n)))
  := nat_induction (fun (x : Nat) => (Eq (mul (succ (succ zero)) (triangular x)) (mul x (succ x))))
    (eq_trans (mul (succ (succ zero)) (triangular zero)) zero (mul zero (succ zero)) (eq_trans (mul (succ
    (succ zero)) (triangular zero))
    (mul (succ (succ zero)) zero) zero (eq_cong (fun (z : Nat) => (mul (succ (succ zero)) z)) (triangular
    zero) zero (triangular_zero))
    (mul_zero_right (succ (succ zero)))) (eq_sym (mul zero (succ zero)) zero (mul_zero (succ zero))))
    (fun (x : Nat) (ih : Prf (Eq (mul (succ (succ zero)) (triangular x)) (mul x (succ x)))) => eq_trans (mul
    (succ (succ zero)) (triangular
    (succ x))) (add (succ x) (mul (succ x) (succ x))) (mul (succ x) (succ (succ x))) (eq_trans (mul (succ
    (succ zero))
    (triangular (succ x))) (add (mul (succ x) (succ x)) (succ x)) (add (succ x) (mul (succ x) (succ x)))
    (eq_trans (mul (succ (succ zero)) (triangular (succ x))) (add (add (succ x) (mul x (succ x))) (succ x))
    (add (mul (succ
    x) (succ x)) (succ x)) (eq_trans (mul (succ (succ zero)) (triangular (succ x))) (add (add (mul x (succ
    x)) (succ x))
    (succ x)) (add (add (succ x) (mul x (succ x))) (succ x)) (eq_trans (mul (succ (succ zero)) (triangular
    (succ x))) (add
    (mul x (succ x)) (add (succ x) (succ x))) (add (add (mul x (succ x)) (succ x)) (succ x)) (eq_trans (mul
    (succ (succ zero)) (triangular (succ x))) (add (mul x (succ x)) (mul (succ (succ zero)) (succ x))) (add
    (mul x (succ x)) (add (succ x)
    (succ x))) (eq_trans (mul (succ (succ zero)) (triangular (succ x))) (add (mul (succ (succ zero))
    (triangular x)) (mul (succ (succ zero)) (succ x)))
    (add (mul x (succ x)) (mul (succ (succ zero)) (succ x))) (eq_trans (mul (succ (succ zero)) (triangular
    (succ x))) (mul (succ (succ zero)) (add
    (triangular x) (succ x))) (add (mul (succ (succ zero)) (triangular x)) (mul (succ (succ zero)) (succ
    x))) (eq_cong (fun (z : Nat) =>
    (mul (succ (succ zero)) z)) (triangular (succ x)) (add (triangular x) (succ x)) (triangular_succ x))
    (mul_add_right (succ (succ zero))
    (triangular x) (succ x))) (eq_cong (fun (z : Nat) => (add z (mul (succ (succ zero)) (succ x)))) (mul
    (succ (succ zero)) (triangular x))
    (mul x (succ x)) (ih))) (eq_cong (fun (z : Nat) => (add (mul x (succ x)) z)) (mul (succ (succ zero))
    (succ x)) (add (succ
    x) (succ x)) (mul_two_left (succ x)))) (eq_sym (add (add (mul x (succ x)) (succ x)) (succ x)) (add (mul
    x
    (succ x)) (add (succ x) (succ x))) (add_assoc (mul x (succ x)) (succ x) (succ x)))) (eq_cong (fun (z :
    Nat) => (add z (succ x))) (add (mul x (succ x)) (succ x)) (add (succ x) (mul x (succ x))) (add_comm (mul
    x
    (succ x)) (succ x)))) (eq_cong (fun (z : Nat) => (add z (succ x))) (add (succ x) (mul x (succ x))) (mul
    (succ x) (succ x)) (eq_sym (mul (succ x) (succ x)) (add (succ x) (mul x (succ x))) (mul_succ x (succ
    x))))) (add_comm (mul (succ x) (succ x)) (succ x))) (eq_sym (mul (succ x) (succ (succ x))) (add (succ x)
    (mul (succ x) (succ x))) (mul_succ_right (succ x) (succ x)))) n;
