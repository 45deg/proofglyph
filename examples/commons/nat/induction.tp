// Checked proofs; prerequisites are imported by subject.
import "order.tp";

theorem nat_strong_induction (P : Nat -> Prop)
  (step : forall (n : Nat), (forall (m : Nat), Prf (Lt m n) -> Prf (P m)) -> Prf (P n))
  (n : Nat) : Prf (P n)
  := imp_elim (Le n n) (P n)
    (all_nat_elim (fun (b : Nat) => (Imp (Le b n) (P b)))
      (nat_induction (fun (x : Nat) => (AllNat (fun (b : Nat) => (Imp (Le b x) (P b))))) (all_nat_intro (fun
    (b : Nat) => (Imp (Le b zero) (P b)))
  (fun (b : Nat) => imp_intro (Le b zero) (P b) (fun (h : Prf (Le b zero)) =>
    eq_subst P zero b (eq_sym b zero (le_zero_eq b h)) (step zero (fun (m : Nat) (h : Prf (Lt m zero)) =>
    false_elim (P m) (lt_zero_absurd m h))))))
        (fun (x : Nat) (ih : Prf (AllNat (fun (b : Nat) => (Imp (Le b x) (P b))))) => all_nat_intro (fun (b
    : Nat) => (Imp (Le b (succ x)) (P b)))
  (fun (b : Nat) => imp_intro (Le b (succ x)) (P b) (fun (h : Prf (Le b (succ x))) =>
    or_elim (Le b x) (Eq b (succ x)) (P b) (le_succ_split b x h)
      (fun (hle : Prf (Le b x)) => imp_elim (Le b x) (P b)
        (all_nat_elim (fun (b : Nat) => (Imp (Le b x) (P b))) ih b) hle)
      (fun (he : Prf (Eq b (succ x))) => eq_subst P (succ x) b (eq_sym b (succ x) he) (step (succ x) (fun (m
    : Nat) (hlt : Prf (Lt m (succ x))) =>
  imp_elim (Le m x) (P m) (all_nat_elim (fun (b : Nat) => (Imp (Le b x) (P b))) ih m)
    (lt_succ_to_le m x hlt))))))) n) n) (le_refl n);
