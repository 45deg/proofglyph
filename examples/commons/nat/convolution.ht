    (choose x k) (f k))))))) (all_seq_intro (fun (f : Nat -> Nat) => (Eq (convolution zero f (fun (k : Nat)
    => (succ zero))) (sum (succ zero) (fun (k : Nat) => mul (choose zero k) (f k))))) (fun (f : Nat -> Nat)
