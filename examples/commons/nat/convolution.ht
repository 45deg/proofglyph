    (f k))) zero (sum_zero (fun (k : Nat) => mul (choose zero k) (f k))))) (eq_cong (fun (z : Nat) => (add
    zero z)) (mul (choose zero zero) (f zero)) (f zero) (eq_trans (mul (choose zero zero) (f zero)) (mul
