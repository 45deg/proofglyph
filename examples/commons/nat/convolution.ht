    i) (g j)))) (mul (f zero) (g (succ n)))) (diagonal n (fun (i j : Nat) => mul (choose n (succ i)) (mul (f
    (succ i)) (g j))))) (add (diagonal n (fun (i j : Nat) => mul (choose n i) (mul ((fun (k : Nat) => f
    (succ k)) i) (g j)))) (add (mul (f zero) (g (succ n))) (diagonal n (fun (i j : Nat) => mul (choose n
    (succ i)) (mul (f (succ i)) (g j)))))) (eq_trans (convolution (succ n) f g) (add (add (mul (f zero) (g
    (succ n))) (diagonal n (fun (i j : Nat) => mul (choose n i) (mul ((fun (k : Nat) => f (succ k)) i) (g
