    (choose n i) (mul ((fun (k : Nat) => f (succ k)) i) (g j))) i j) ((fun (i j : Nat) => mul (choose n
    (succ i)) (mul (f (succ i)) (g j))) i j))) (add (diagonal n (fun (i j : Nat) => mul (choose n i) (mul
    ((fun (k : Nat) => f (succ k)) i) (g j)))) (diagonal n (fun (i j : Nat) => mul (choose n (succ i)) (mul
    (f (succ i)) (g j))))) (diagonal_add n (fun (i j : Nat) => mul (choose n i) (mul ((fun (k : Nat) => f
    (succ k)) i) (g j))) (fun (i j : Nat) => mul (choose n (succ i)) (mul (f (succ i)) (g j)))))) (eq_sym
    (add (add (mul (f zero) (g (succ n))) (diagonal n (fun (i j : Nat) => mul (choose n i) (mul ((fun (k :
