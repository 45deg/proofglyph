    (succ x) f (fun (k : Nat) => (succ zero))) (add (convolution x (fun (k : Nat) => f (succ k)) (fun (k :
    Nat) => (succ zero))) (convolution x f (fun (k : Nat) => (succ zero)))) (add (sum (succ x) (fun (k :
