    k))) ((all_seq_elim (fun (f : Nat -> Nat) => (Eq (convolution x f (fun (k : Nat) => (succ zero))) (sum
    (succ x) (fun (k : Nat) => mul (choose x k) (f k))))) (ih) (fun (k : Nat) => f (succ k)))))) (eq_cong
    (fun (z : Nat) => (add (sum (succ x) (fun (k : Nat) => mul (choose x k) ((fun (k : Nat) => f (succ k))
    k))) z)) (convolution x f (fun (k : Nat) => (succ zero))) (sum (succ x) (fun (k : Nat) => mul (choose x
    k) (f k))) ((all_seq_elim (fun (f : Nat -> Nat) => (Eq (convolution x f (fun (k : Nat) => (succ zero)))
    (sum (succ x) (fun (k : Nat) => mul (choose x k) (f k))))) (ih) f)))) (eq_sym (sum (succ (succ x)) (fun
    (k : Nat) => mul (choose (succ x) k) (f k))) (add (sum (succ x) (fun (k : Nat) => mul (choose x k) ((fun
    (k : Nat) => f (succ k)) k))) (sum (succ x) (fun (k : Nat) => mul (choose x k) (f k))))
    (binomial_row_pascal x f)))) n) f;

theorem convolution_unit_right (n : Nat) (f : Nat -> Nat) (hn : Prf (Lt zero n)) : Prf (Eq (convolution n f
    (fun (k : Nat) => (succ zero))) (add (add (f n) (f zero)) (sum_between zero n (fun (k : Nat) => mul
    (choose n k) (f k)))))
  := eq_trans (convolution n f (fun (k : Nat) => (succ zero))) (sum (succ n) (fun (k : Nat) => mul (choose n
    k) (f k))) (add (add (f n) (f zero)) (sum_between zero n (fun (k : Nat) => mul (choose n k) (f k))))
    (convolution_unit_row n f) (binomial_row_endpoints n f hn);
