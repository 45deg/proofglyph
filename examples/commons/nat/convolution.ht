theorem convolution_ext (n : Nat) (f g u v : Nat -> Nat)
  (hf : forall (k : Nat), Prf (Eq (f k) (u k))) (hg : forall (k : Nat), Prf (Eq (g k) (v k)))
  : Prf (Eq (convolution n f g) (convolution n u v))
  := imp_elim (AllNat (fun (k : Nat) => (Eq (g k) (v k)))) (Eq (convolution n f g) (convolution n u v))
    (imp_elim (AllNat (fun (k : Nat) => (Eq (f k) (u k)))) (Imp (AllNat (fun (k : Nat) => (Eq (g k) (v k))))
    (Eq (convolution n f g) (convolution n u v)))
      (convolution_ext_rule n f g u v) (all_nat_intro (fun (k : Nat) => Eq (f k) (u k)) hf))
    (all_nat_intro (fun (k : Nat) => Eq (g k) (v k)) hg);

