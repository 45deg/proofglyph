    (fun (k : Nat) => (Eq (g k) (v k)))) (Eq (convolution n f g) (convolution n u v))))) (all_seq_elim (fun
    (u : Nat -> Nat) => (AllSeq (fun (v : Nat -> Nat) => (Imp (AllNat (fun (k : Nat) => (Eq (f k) (u k))))
    (Imp (AllNat (fun (k : Nat) => (Eq (g k) (v k)))) (Eq (convolution n f g) (convolution n u v)))))))
    (all_seq_elim (fun (g : Nat -> Nat) => (AllSeq (fun (u : Nat -> Nat) => (AllSeq (fun (v : Nat -> Nat) =>
    (Imp (AllNat (fun (k : Nat) => (Eq (f k) (u k)))) (Imp (AllNat (fun (k : Nat) => (Eq (g k) (v k)))) (Eq
    (convolution n f g) (convolution n u v))))))))) (all_seq_elim (fun (f : Nat -> Nat) => (AllSeq (fun (g :
    Nat -> Nat) => (AllSeq (fun (u : Nat -> Nat) => (AllSeq (fun (v : Nat -> Nat) => (Imp (AllNat (fun (k :
    Nat) => (Eq (f k) (u k)))) (Imp (AllNat (fun (k : Nat) => (Eq (g k) (v k)))) (Eq (convolution n f g)
    (convolution n u v))))))))))) (nat_induction (fun (x : Nat) => (AllSeq (fun (f : Nat -> Nat) => (AllSeq
    (fun (g : Nat -> Nat) => (AllSeq (fun (u : Nat -> Nat) => (AllSeq (fun (v : Nat -> Nat) => (Imp (AllNat
    (fun (k : Nat) => (Eq (f k) (u k)))) (Imp (AllNat (fun (k : Nat) => (Eq (g k) (v k)))) (Eq (convolution
    x f g) (convolution x u v))))))))))))) (all_seq_intro (fun (f : Nat -> Nat) => (AllSeq (fun (g : Nat ->
    Nat) => (AllSeq (fun (u : Nat -> Nat) => (AllSeq (fun (v : Nat -> Nat) => (Imp (AllNat (fun (k : Nat) =>
    (Eq (f k) (u k)))) (Imp (AllNat (fun (k : Nat) => (Eq (g k) (v k)))) (Eq (convolution zero f g)
    (convolution zero u v))))))))))) (fun (f : Nat -> Nat) => all_seq_intro (fun (g : Nat -> Nat) => (AllSeq
    (fun (u : Nat -> Nat) => (AllSeq (fun (v : Nat -> Nat) => (Imp (AllNat (fun (k : Nat) => (Eq (f k) (u
    k)))) (Imp (AllNat (fun (k : Nat) => (Eq (g k) (v k)))) (Eq (convolution zero f g) (convolution zero u
    v))))))))) (fun (g : Nat -> Nat) => all_seq_intro (fun (u : Nat -> Nat) => (AllSeq (fun (v : Nat -> Nat)
    => (Imp (AllNat (fun (k : Nat) => (Eq (f k) (u k)))) (Imp (AllNat (fun (k : Nat) => (Eq (g k) (v k))))
    (Eq (convolution zero f g) (convolution zero u v))))))) (fun (u : Nat -> Nat) => all_seq_intro (fun (v :
    Nat -> Nat) => (Imp (AllNat (fun (k : Nat) => (Eq (f k) (u k)))) (Imp (AllNat (fun (k : Nat) => (Eq (g
    k) (v k)))) (Eq (convolution zero f g) (convolution zero u v))))) (fun (v : Nat -> Nat) => imp_intro
    (AllNat (fun (k : Nat) => (Eq (f k) (u k)))) (Imp (AllNat (fun (k : Nat) => (Eq (g k) (v k)))) (Eq
    (convolution zero f g) (convolution zero u v))) (fun (hf : Prf (AllNat (fun (k : Nat) => (Eq (f k) (u
    k))))) => imp_intro (AllNat (fun (k : Nat) => (Eq (g k) (v k)))) (Eq (convolution zero f g) (convolution
    zero u v)) (fun (hg : Prf (AllNat (fun (k : Nat) => (Eq (g k) (v k))))) => eq_trans (convolution zero f
    g) (mul (u zero) (v zero)) (convolution zero u v) (eq_trans (convolution zero f g) (mul (u zero) (g
    zero)) (mul (u zero) (v zero)) (eq_trans (convolution zero f g) (mul (f zero) (g zero)) (mul (u zero) (g
    zero)) (convolution_zero f g) (eq_cong (fun (z : Nat) => (mul z (g zero))) (f zero) (u zero)
    (all_nat_elim (fun (k : Nat) => (Eq (f k) (u k))) hf zero))) (eq_cong (fun (z : Nat) => (mul (u zero)
    z)) (g zero) (v zero) (all_nat_elim (fun (k : Nat) => (Eq (g k) (v k))) hg zero))) (eq_sym (convolution
