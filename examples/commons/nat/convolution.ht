    => mul (choose zero k) (f k))) (eq_trans (convolution zero f (fun (k : Nat) => (succ zero))) (mul (f
    zero) (succ zero)) (f zero) (convolution_zero f (fun (k : Nat) => (succ zero))) (mul_one_right (f
    zero))) (eq_sym (sum (succ zero) (fun (k : Nat) => mul (choose zero k) (f k))) (f zero) (eq_trans (sum
    (succ zero) (fun (k : Nat) => mul (choose zero k) (f k))) (add zero (f zero)) (f zero) (eq_trans (sum
    (succ zero) (fun (k : Nat) => mul (choose zero k) (f k))) (add zero (mul (choose zero zero) (f zero)))
    (add zero (f zero)) (eq_trans (sum (succ zero) (fun (k : Nat) => mul (choose zero k) (f k))) (add (sum
    zero (fun (k : Nat) => mul (choose zero k) (f k))) (mul (choose zero zero) (f zero))) (add zero (mul
    (choose zero zero) (f zero))) (sum_succ zero (fun (k : Nat) => mul (choose zero k) (f k))) (eq_cong (fun
