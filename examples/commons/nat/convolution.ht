    (AllNat (fun (k : Nat) => (Eq (g k) (v k)))) (Eq (convolution (succ x) f g) (convolution (succ x) u v))
    (fun (hg : Prf (AllNat (fun (k : Nat) => (Eq (g k) (v k))))) => eq_trans (convolution (succ x) f g) (add
