    all_seq_intro (fun (g : Nat -> Nat) => (AllSeq (fun (u : Nat -> Nat) => (AllSeq (fun (v : Nat -> Nat) =>
    (Imp (AllNat (fun (k : Nat) => (Eq (f k) (u k)))) (Imp (AllNat (fun (k : Nat) => (Eq (g k) (v k)))) (Eq
