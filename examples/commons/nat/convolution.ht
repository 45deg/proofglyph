theorem convolution_zero (f g : Nat -> Nat) : Prf (Eq (convolution zero f g) (mul (f zero) (g zero)))
  := eq_trans (convolution zero f g) (mul (succ zero) (mul (f zero) (g zero))) (mul (f zero) (g zero))
    (eq_trans (convolution zero f g) (mul (choose zero zero) (mul (f zero) (g zero))) (mul (succ zero) (mul
    (f zero) (g zero))) (eq_trans (convolution zero f g) (diagonal zero (fun (i j : Nat) => mul (choose zero
    i) (mul (f i) (g j)))) (mul (choose zero zero) (mul (f zero) (g zero))) (convolution_definition zero f
    g) (diagonal_zero (fun (i j : Nat) => mul (choose zero i) (mul (f i) (g j))))) (eq_cong (fun (z : Nat)
    => (mul z (mul (f zero) (g zero)))) (choose zero zero) (succ zero) (choose_zero_column zero)))
    (mul_one_left (mul (f zero) (g zero)));

theorem convolution_ext_rule (n : Nat) (f g u v : Nat -> Nat) : Prf (Imp (AllNat (fun (k : Nat) => (Eq (f k)
    (u k)))) (Imp (AllNat (fun (k : Nat) => (Eq (g k) (v k)))) (Eq (convolution n f g) (convolution n u
    v))))
