    n (succ i)) (mul (f (succ i)) (g j)))))) (eq_trans (convolution (succ n) f g) (add (mul (f zero) (g
    (succ n))) (diagonal n (fun (i j : Nat) => (fun (i j : Nat) => mul (choose (succ n) i) (mul (f i) (g
    j))) (succ i) j))) (add (mul (f zero) (g (succ n))) (diagonal n (fun (i j : Nat) => add ((fun (i j :
