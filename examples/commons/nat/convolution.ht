    k))) (sum (succ x) (fun (k : Nat) => mul (choose x k) (f k)))) (sum (succ (succ x)) (fun (k : Nat) =>
    mul (choose (succ x) k) (f k))) (eq_trans (convolution (succ x) f (fun (k : Nat) => (succ zero))) (add
