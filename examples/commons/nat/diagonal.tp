// Checked proofs; prerequisites are imported by subject.
import "../foundation/binomial.tp";
import "addition.tp";

theorem diagonal_add (n : Nat) (h u : Nat -> Nat -> Nat) : Prf (Eq (diagonal n (fun (i j : Nat) => add (h i
    j) (u i j))) (add (diagonal n h) (diagonal n u)))
  := all_bi_elim (fun (u : Nat -> Nat -> Nat) => (Eq (diagonal n (fun (i j : Nat) => add (h i j) (u i j)))
    (add (diagonal n h) (diagonal n u)))) (all_bi_elim (fun (h : Nat -> Nat -> Nat) => (AllBi (fun (u : Nat
    -> Nat -> Nat) => (Eq (diagonal n (fun (i j : Nat) => add (h i j) (u i j))) (add (diagonal n h)
    (diagonal n u)))))) (nat_induction (fun (x : Nat) => (AllBi (fun (h : Nat -> Nat -> Nat) => (AllBi (fun
    (u : Nat -> Nat -> Nat) => (Eq (diagonal x (fun (i j : Nat) => add (h i j) (u i j))) (add (diagonal x h)
    (diagonal x u)))))))) (all_bi_intro (fun (h : Nat -> Nat -> Nat) => (AllBi (fun (u : Nat -> Nat -> Nat)
    => (Eq (diagonal zero (fun (i j : Nat) => add (h i j) (u i j))) (add (diagonal zero h) (diagonal zero
    u)))))) (fun (h : Nat -> Nat -> Nat) => all_bi_intro (fun (u : Nat -> Nat -> Nat) => (Eq (diagonal zero
    (fun (i j : Nat) => add (h i j) (u i j))) (add (diagonal zero h) (diagonal zero u)))) (fun (u : Nat ->
    Nat -> Nat) => eq_trans (diagonal zero (fun (i j : Nat) => add (h i j) (u i j))) (add (diagonal zero h)
    (u zero zero)) (add (diagonal zero h) (diagonal zero u)) (eq_trans (diagonal zero (fun (i j : Nat) =>
    add (h i j) (u i j))) (add (h zero zero) (u zero zero)) (add (diagonal zero h) (u zero zero))
    (diagonal_zero (fun (i j : Nat) => add (h i j) (u i j))) (eq_sym (add (diagonal zero h) (u zero zero))
    (add (h zero zero) (u zero zero)) (eq_cong (fun (z : Nat) => (add z (u zero zero))) (diagonal zero h) (h
    zero zero) (diagonal_zero h)))) (eq_sym (add (diagonal zero h) (diagonal zero u)) (add (diagonal zero h)
    (u zero zero)) (eq_cong (fun (z : Nat) => (add (diagonal zero h) z)) (diagonal zero u) (u zero zero)
    (diagonal_zero u)))))) (fun (x : Nat) (ih : Prf (AllBi (fun (h : Nat -> Nat -> Nat) => (AllBi (fun (u :
    Nat -> Nat -> Nat) => (Eq (diagonal x (fun (i j : Nat) => add (h i j) (u i j))) (add (diagonal x h)
    (diagonal x u)))))))) => all_bi_intro (fun (h : Nat -> Nat -> Nat) => (AllBi (fun (u : Nat -> Nat ->
    Nat) => (Eq (diagonal (succ x) (fun (i j : Nat) => add (h i j) (u i j))) (add (diagonal (succ x) h)
    (diagonal (succ x) u)))))) (fun (h : Nat -> Nat -> Nat) => all_bi_intro (fun (u : Nat -> Nat -> Nat) =>
    (Eq (diagonal (succ x) (fun (i j : Nat) => add (h i j) (u i j))) (add (diagonal (succ x) h) (diagonal
    (succ x) u)))) (fun (u : Nat -> Nat -> Nat) => eq_trans (diagonal (succ x) (fun (i j : Nat) => add (h i
    j) (u i j))) (add (diagonal (succ x) h) (add (diagonal x (fun (i j : Nat) => u i (succ j))) (u (succ x)
    zero))) (add (diagonal (succ x) h) (diagonal (succ x) u)) (eq_trans (diagonal (succ x) (fun (i j : Nat)
    => add (h i j) (u i j))) (add (add (diagonal x (fun (i j : Nat) => h i (succ j))) (h (succ x) zero))
    (add (diagonal x (fun (i j : Nat) => u i (succ j))) (u (succ x) zero))) (add (diagonal (succ x) h) (add
    (diagonal x (fun (i j : Nat) => u i (succ j))) (u (succ x) zero))) (eq_trans (diagonal (succ x) (fun (i
    j : Nat) => add (h i j) (u i j))) (add (add (diagonal x (fun (i j : Nat) => h i (succ j))) (diagonal x
    (fun (i j : Nat) => u i (succ j)))) (add (h (succ x) zero) (u (succ x) zero))) (add (add (diagonal x
    (fun (i j : Nat) => h i (succ j))) (h (succ x) zero)) (add (diagonal x (fun (i j : Nat) => u i (succ
    j))) (u (succ x) zero))) (eq_trans (diagonal (succ x) (fun (i j : Nat) => add (h i j) (u i j))) (add
    (diagonal x (fun (i j : Nat) => add (h i (succ j)) (u i (succ j)))) (add (h (succ x) zero) (u (succ x)
    zero))) (add (add (diagonal x (fun (i j : Nat) => h i (succ j))) (diagonal x (fun (i j : Nat) => u i
    (succ j)))) (add (h (succ x) zero) (u (succ x) zero))) (diagonal_succ x (fun (i j : Nat) => add (h i j)
    (u i j))) (eq_cong (fun (z : Nat) => (add z (add (h (succ x) zero) (u (succ x) zero)))) (diagonal x (fun
    (i j : Nat) => add (h i (succ j)) (u i (succ j)))) (add (diagonal x (fun (i j : Nat) => h i (succ j)))
    (diagonal x (fun (i j : Nat) => u i (succ j)))) ((all_bi_elim (fun (u : Nat -> Nat -> Nat) => (Eq
    (diagonal x (fun (i j : Nat) => add ((fun (i j : Nat) => h i (succ j)) i j) (u i j))) (add (diagonal x
    (fun (i j : Nat) => h i (succ j))) (diagonal x u)))) (all_bi_elim (fun (h : Nat -> Nat -> Nat) => (AllBi
    (fun (u : Nat -> Nat -> Nat) => (Eq (diagonal x (fun (i j : Nat) => add (h i j) (u i j))) (add (diagonal
    x h) (diagonal x u)))))) (ih) (fun (i j : Nat) => h i (succ j))) (fun (i j : Nat) => u i (succ j))))))
    (add_interchange (diagonal x (fun (i j : Nat) => h i (succ j))) (diagonal x (fun (i j : Nat) => u i
    (succ j))) (h (succ x) zero) (u (succ x) zero))) (eq_cong (fun (z : Nat) => (add z (add (diagonal x (fun
    (i j : Nat) => u i (succ j))) (u (succ x) zero)))) (add (diagonal x (fun (i j : Nat) => h i (succ j)))
    (h (succ x) zero)) (diagonal (succ x) h) (eq_sym (diagonal (succ x) h) (add (diagonal x (fun (i j : Nat)
    => h i (succ j))) (h (succ x) zero)) (diagonal_succ x h)))) (eq_cong (fun (z : Nat) => (add (diagonal
    (succ x) h) z)) (add (diagonal x (fun (i j : Nat) => u i (succ j))) (u (succ x) zero)) (diagonal (succ
    x) u) (eq_sym (diagonal (succ x) u) (add (diagonal x (fun (i j : Nat) => u i (succ j))) (u (succ x)
    zero)) (diagonal_succ x u)))))) n) h) u;

theorem diagonal_ext_rule (n : Nat) (h u : Nat -> Nat -> Nat) : Prf (Imp (AllNat (fun (i : Nat) => AllNat
    (fun (j : Nat) => (Eq (h i j) (u i j))))) (Eq (diagonal n h) (diagonal n u)))
  := all_bi_elim (fun (u : Nat -> Nat -> Nat) => (Imp (AllNat (fun (i : Nat) => AllNat (fun (j : Nat) => (Eq
    (h i j) (u i j))))) (Eq (diagonal n h) (diagonal n u)))) (all_bi_elim (fun (h : Nat -> Nat -> Nat) =>
    (AllBi (fun (u : Nat -> Nat -> Nat) => (Imp (AllNat (fun (i : Nat) => AllNat (fun (j : Nat) => (Eq (h i
    j) (u i j))))) (Eq (diagonal n h) (diagonal n u)))))) (nat_induction (fun (x : Nat) => (AllBi (fun (h :
    Nat -> Nat -> Nat) => (AllBi (fun (u : Nat -> Nat -> Nat) => (Imp (AllNat (fun (i : Nat) => AllNat (fun
    (j : Nat) => (Eq (h i j) (u i j))))) (Eq (diagonal x h) (diagonal x u)))))))) (all_bi_intro (fun (h :
    Nat -> Nat -> Nat) => (AllBi (fun (u : Nat -> Nat -> Nat) => (Imp (AllNat (fun (i : Nat) => AllNat (fun
    (j : Nat) => (Eq (h i j) (u i j))))) (Eq (diagonal zero h) (diagonal zero u)))))) (fun (h : Nat -> Nat
    -> Nat) => all_bi_intro (fun (u : Nat -> Nat -> Nat) => (Imp (AllNat (fun (i : Nat) => AllNat (fun (j :
    Nat) => (Eq (h i j) (u i j))))) (Eq (diagonal zero h) (diagonal zero u)))) (fun (u : Nat -> Nat -> Nat)
    => imp_intro (AllNat (fun (i : Nat) => AllNat (fun (j : Nat) => (Eq (h i j) (u i j))))) (Eq (diagonal
    zero h) (diagonal zero u)) (fun (he : Prf (AllNat (fun (i : Nat) => AllNat (fun (j : Nat) => (Eq (h i j)
    (u i j)))))) => eq_trans (diagonal zero h) (u zero zero) (diagonal zero u) (eq_trans (diagonal zero h)
    (h zero zero) (u zero zero) (diagonal_zero h) ((all_nat_elim (fun (j : Nat) => (Eq (h zero j) (u zero
    j))) (all_nat_elim (fun (i : Nat) => AllNat (fun (j : Nat) => (Eq (h i j) (u i j)))) he zero) zero)))
    (eq_sym (diagonal zero u) (u zero zero) (diagonal_zero u)))))) (fun (x : Nat) (ih : Prf (AllBi (fun (h :
    Nat -> Nat -> Nat) => (AllBi (fun (u : Nat -> Nat -> Nat) => (Imp (AllNat (fun (i : Nat) => AllNat (fun
    (j : Nat) => (Eq (h i j) (u i j))))) (Eq (diagonal x h) (diagonal x u)))))))) => all_bi_intro (fun (h :
    Nat -> Nat -> Nat) => (AllBi (fun (u : Nat -> Nat -> Nat) => (Imp (AllNat (fun (i : Nat) => AllNat (fun
    (j : Nat) => (Eq (h i j) (u i j))))) (Eq (diagonal (succ x) h) (diagonal (succ x) u)))))) (fun (h : Nat
    -> Nat -> Nat) => all_bi_intro (fun (u : Nat -> Nat -> Nat) => (Imp (AllNat (fun (i : Nat) => AllNat
    (fun (j : Nat) => (Eq (h i j) (u i j))))) (Eq (diagonal (succ x) h) (diagonal (succ x) u)))) (fun (u :
    Nat -> Nat -> Nat) => imp_intro (AllNat (fun (i : Nat) => AllNat (fun (j : Nat) => (Eq (h i j) (u i
    j))))) (Eq (diagonal (succ x) h) (diagonal (succ x) u)) (fun (he : Prf (AllNat (fun (i : Nat) => AllNat
    (fun (j : Nat) => (Eq (h i j) (u i j)))))) => eq_trans (diagonal (succ x) h) (add (diagonal x (fun (i j
    : Nat) => u i (succ j))) (u (succ x) zero)) (diagonal (succ x) u) (eq_trans (diagonal (succ x) h) (add
    (diagonal x (fun (i j : Nat) => u i (succ j))) (h (succ x) zero)) (add (diagonal x (fun (i j : Nat) => u
    i (succ j))) (u (succ x) zero)) (eq_trans (diagonal (succ x) h) (add (diagonal x (fun (i j : Nat) => h i
    (succ j))) (h (succ x) zero)) (add (diagonal x (fun (i j : Nat) => u i (succ j))) (h (succ x) zero))
    (diagonal_succ x h) (eq_cong (fun (z : Nat) => (add z (h (succ x) zero))) (diagonal x (fun (i j : Nat)
    => h i (succ j))) (diagonal x (fun (i j : Nat) => u i (succ j))) ((imp_elim (AllNat (fun (i : Nat) =>
    AllNat (fun (j : Nat) => (Eq ((fun (i j : Nat) => h i (succ j)) i j) ((fun (i j : Nat) => u i (succ j))
    i j))))) (Eq (diagonal x (fun (i j : Nat) => h i (succ j))) (diagonal x (fun (i j : Nat) => u i (succ
    j)))) (all_bi_elim (fun (u : Nat -> Nat -> Nat) => (Imp (AllNat (fun (i : Nat) => AllNat (fun (j : Nat)
    => (Eq ((fun (i j : Nat) => h i (succ j)) i j) (u i j))))) (Eq (diagonal x (fun (i j : Nat) => h i (succ
    j))) (diagonal x u)))) (all_bi_elim (fun (h : Nat -> Nat -> Nat) => (AllBi (fun (u : Nat -> Nat -> Nat)
    => (Imp (AllNat (fun (i : Nat) => AllNat (fun (j : Nat) => (Eq (h i j) (u i j))))) (Eq (diagonal x h)
    (diagonal x u)))))) (ih) (fun (i j : Nat) => h i (succ j))) (fun (i j : Nat) => u i (succ j)))
    (all_nat_intro (fun (i : Nat) => AllNat (fun (j : Nat) => (Eq (h i (succ j)) (u i (succ j)))))
  (fun (i : Nat) => all_nat_intro (fun (j : Nat) => (Eq (h i (succ j)) (u i (succ j))))
    (fun (j : Nat) => all_nat_elim (fun (j : Nat) => (Eq (h i j) (u i j))) (all_nat_elim (fun (i : Nat) =>
    AllNat (fun (j : Nat) => (Eq (h i j) (u i j)))) he i) (succ j)))))))) (eq_cong (fun (z : Nat) => (add
    (diagonal x (fun (i j : Nat) => u i (succ j))) z)) (h (succ x) zero) (u (succ x) zero) ((all_nat_elim
    (fun (j : Nat) => (Eq (h (succ x) j) (u (succ x) j))) (all_nat_elim (fun (i : Nat) => AllNat (fun (j :
    Nat) => (Eq (h i j) (u i j)))) he (succ x)) zero)))) (eq_sym (diagonal (succ x) u) (add (diagonal x (fun
    (i j : Nat) => u i (succ j))) (u (succ x) zero)) (diagonal_succ x u)))))) n) h) u;

theorem diagonal_ext (n : Nat) (h u : Nat -> Nat -> Nat)
  (he : forall (i j : Nat), Prf (Eq (h i j) (u i j))) : Prf (Eq (diagonal n h) (diagonal n u))
  := imp_elim (AllNat (fun (i : Nat) => AllNat (fun (j : Nat) => (Eq (h i j) (u i j))))) (Eq (diagonal n h)
    (diagonal n u)) (diagonal_ext_rule n h u)
    (all_nat_intro (fun (i : Nat) => AllNat (fun (j : Nat) => Eq (h i j) (u i j)))
      (fun (i : Nat) => all_nat_intro (fun (j : Nat) => Eq (h i j) (u i j)) (he i)));

theorem diagonal_shift_left (n : Nat) (h : Nat -> Nat -> Nat) : Prf (Eq (diagonal (succ n) h) (add (h zero
    (succ n)) (diagonal n (fun (i j : Nat) => h (succ i) j))))
  := all_bi_elim (fun (h : Nat -> Nat -> Nat) => (Eq (diagonal (succ n) h) (add (h zero (succ n)) (diagonal
    n (fun (i j : Nat) => h (succ i) j))))) (nat_induction (fun (x : Nat) => (AllBi (fun (h : Nat -> Nat ->
    Nat) => (Eq (diagonal (succ x) h) (add (h zero (succ x)) (diagonal x (fun (i j : Nat) => h (succ i)
    j))))))) (all_bi_intro (fun (h : Nat -> Nat -> Nat) => (Eq (diagonal (succ zero) h) (add (h zero (succ
    zero)) (diagonal zero (fun (i j : Nat) => h (succ i) j))))) (fun (h : Nat -> Nat -> Nat) => eq_trans
    (diagonal (succ zero) h) (add (h zero (succ zero)) (h (succ zero) zero)) (add (h zero (succ zero))
    (diagonal zero (fun (i j : Nat) => h (succ i) j))) (eq_trans (diagonal (succ zero) h) (add (diagonal
    zero (fun (i j : Nat) => h i (succ j))) (h (succ zero) zero)) (add (h zero (succ zero)) (h (succ zero)
    zero)) (diagonal_succ zero h) (eq_cong (fun (z : Nat) => (add z (h (succ zero) zero))) (diagonal zero
    (fun (i j : Nat) => h i (succ j))) (h zero (succ zero)) (diagonal_zero (fun (i j : Nat) => h i (succ
    j))))) (eq_sym (add (h zero (succ zero)) (diagonal zero (fun (i j : Nat) => h (succ i) j))) (add (h zero
    (succ zero)) (h (succ zero) zero)) (eq_cong (fun (z : Nat) => (add (h zero (succ zero)) z)) (diagonal
    zero (fun (i j : Nat) => h (succ i) j)) (h (succ zero) zero) (diagonal_zero (fun (i j : Nat) => h (succ
    i) j)))))) (fun (x : Nat) (ih : Prf (AllBi (fun (h : Nat -> Nat -> Nat) => (Eq (diagonal (succ x) h)
    (add (h zero (succ x)) (diagonal x (fun (i j : Nat) => h (succ i) j))))))) => all_bi_intro (fun (h : Nat
    -> Nat -> Nat) => (Eq (diagonal (succ (succ x)) h) (add (h zero (succ (succ x))) (diagonal (succ x) (fun
    (i j : Nat) => h (succ i) j))))) (fun (h : Nat -> Nat -> Nat) => eq_trans (diagonal (succ (succ x)) h)
    (add (h zero (succ (succ x))) (add (diagonal x (fun (i j : Nat) => h (succ i) (succ j))) (h (succ (succ
    x)) zero))) (add (h zero (succ (succ x))) (diagonal (succ x) (fun (i j : Nat) => h (succ i) j)))
    (eq_trans (diagonal (succ (succ x)) h) (add (add (h zero (succ (succ x))) (diagonal x (fun (i j : Nat)
    => h (succ i) (succ j)))) (h (succ (succ x)) zero)) (add (h zero (succ (succ x))) (add (diagonal x (fun
    (i j : Nat) => h (succ i) (succ j))) (h (succ (succ x)) zero))) (eq_trans (diagonal (succ (succ x)) h)
    (add (diagonal (succ x) (fun (i j : Nat) => h i (succ j))) (h (succ (succ x)) zero)) (add (add (h zero
    (succ (succ x))) (diagonal x (fun (i j : Nat) => h (succ i) (succ j)))) (h (succ (succ x)) zero))
    (diagonal_succ (succ x) h) (eq_cong (fun (z : Nat) => (add z (h (succ (succ x)) zero))) (diagonal (succ
    x) (fun (i j : Nat) => h i (succ j))) (add (h zero (succ (succ x))) (diagonal x (fun (i j : Nat) => h
    (succ i) (succ j)))) ((all_bi_elim (fun (h : Nat -> Nat -> Nat) => (Eq (diagonal (succ x) h) (add (h
    zero (succ x)) (diagonal x (fun (i j : Nat) => h (succ i) j))))) (ih) (fun (i j : Nat) => h i (succ
    j)))))) (add_assoc (h zero (succ (succ x))) (diagonal x (fun (i j : Nat) => h (succ i) (succ j))) (h
    (succ (succ x)) zero))) (eq_cong (fun (z : Nat) => (add (h zero (succ (succ x))) z)) (add (diagonal x
    (fun (i j : Nat) => h (succ i) (succ j))) (h (succ (succ x)) zero)) (diagonal (succ x) (fun (i j : Nat)
    => h (succ i) j)) (eq_sym (diagonal (succ x) (fun (i j : Nat) => h (succ i) j)) (add (diagonal x (fun (i
    j : Nat) => h (succ i) (succ j))) (h (succ (succ x)) zero)) (diagonal_succ x (fun (i j : Nat) => h (succ
    i) j)))))) n) h;
