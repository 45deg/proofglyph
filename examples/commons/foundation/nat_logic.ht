// Primitive quantification over binary natural-number functions.
// AllNat and AllSeq use evaluation and constant-function embeddings of AllBi.
// Their inference rules and the existential rules are checked proofs.

import "peano.ht";

symbol AllBi : ((Nat -> Nat -> Nat) -> Prop) -> Prop;

axiom all_bi_elim (P : (Nat -> Nat -> Nat) -> Prop) : Prf (AllBi P) -> forall (h : Nat -> Nat -> Nat), Prf
    (P h);

axiom all_bi_intro (P : (Nat -> Nat -> Nat) -> Prop) : (forall (h : Nat -> Nat -> Nat), Prf (P h)) -> Prf
    (AllBi P);

def AllNat (P : Nat -> Prop) : Prop :=
  AllBi (fun (h : Nat -> Nat -> Nat) => P (h zero zero));
theorem all_nat_intro (P : Nat -> Prop) (proof : forall (n : Nat), Prf (P n)) : Prf (AllNat P) :=
  all_bi_intro (fun (h : Nat -> Nat -> Nat) => P (h zero zero))
    (fun (h : Nat -> Nat -> Nat) => proof (h zero zero));
theorem all_nat_elim (P : Nat -> Prop) (proof : Prf (AllNat P)) (n : Nat) : Prf (P n) :=
  all_bi_elim (fun (h : Nat -> Nat -> Nat) => P (h zero zero)) proof
    (fun (i j : Nat) => n);

def AllSeq (P : (Nat -> Nat) -> Prop) : Prop :=
  AllBi (fun (h : Nat -> Nat -> Nat) => P (h zero));
theorem all_seq_intro (P : (Nat -> Nat) -> Prop)
  (proof : forall (f : Nat -> Nat), Prf (P f)) : Prf (AllSeq P) :=
  all_bi_intro (fun (h : Nat -> Nat -> Nat) => P (h zero))
    (fun (h : Nat -> Nat -> Nat) => proof (h zero));
theorem all_seq_elim (P : (Nat -> Nat) -> Prop) (proof : Prf (AllSeq P))
  (f : Nat -> Nat) : Prf (P f) :=
  all_bi_elim (fun (h : Nat -> Nat -> Nat) => P (h zero)) proof
    (fun (i : Nat) => f);

// Existential quantification is defined by its continuation encoding.
def Exists (P : Nat -> Prop) : Prop :=
  AllProp (fun (C : Prop) => Imp (AllNat (fun (x : Nat) => Imp (P x) C)) C);
theorem exists_intro (P : Nat -> Prop) (x : Nat) (h : Prf (P x)) : Prf (Exists P) :=
  all_prop_intro (fun (C : Prop) => Imp (AllNat (fun (y : Nat) => Imp (P y) C)) C)
    (fun (C : Prop) => imp_intro (AllNat (fun (y : Nat) => Imp (P y) C)) C
      (fun (f : Prf (AllNat (fun (y : Nat) => Imp (P y) C))) =>
        imp_elim (P x) C (all_nat_elim (fun (y : Nat) => Imp (P y) C) f x) h));
theorem exists_elim (P : Nat -> Prop) (C : Prop) (h : Prf (Exists P))
  (f : forall (x : Nat), Prf (P x) -> Prf C) : Prf C :=
  imp_elim (AllNat (fun (x : Nat) => Imp (P x) C)) C
    (all_prop_elim (fun (D : Prop) => Imp (AllNat (fun (x : Nat) => Imp (P x) D)) D) h C)
    (all_nat_intro (fun (x : Nat) => Imp (P x) C)
      (fun (x : Nat) => imp_intro (P x) C (f x)));
