// Definition of divisibility; no predicate-specific axioms.
// Definitions are expanded by Hieratic; every theorem is checked by the kernel.

import "arithmetic.ht";
import "nat_logic.ht";

def Divides (d a : Nat) : Prop := Exists (fun (k : Nat) => Eq a (mul d k));

theorem divides_elim (d a : Nat) (P : Prop) (h : Prf (Divides d a))
  (use : forall (k : Nat), Prf (Eq a (mul d k)) -> Prf P) : Prf P
  := exists_elim (fun (k : Nat) => Eq a (mul d k)) P h use;

theorem divides_intro (d a k : Nat) (h : Prf (Eq a (mul d k))) : Prf (Divides d a)
  := exists_intro (fun (k : Nat) => Eq a (mul d k)) k h;
