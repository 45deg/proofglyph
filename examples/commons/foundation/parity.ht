// Definitions of parity; no parity-specific axioms.
// Definitions are expanded by Hieratic; every theorem is checked by the kernel.

import "arithmetic.ht";
import "nat_logic.ht";

def Even (n : Nat) : Prop := Exists (fun (k : Nat) => Eq n (add k k));
def Odd (n : Nat) : Prop := Exists (fun (k : Nat) => Eq n (succ (add k k)));

theorem even_elim (n : Nat) (P : Prop) (h : Prf (Even n))
  (use : forall (k : Nat), Prf (Eq n (add k k)) -> Prf P) : Prf P
  := exists_elim (fun (k : Nat) => Eq n (add k k)) P h use;
theorem even_intro (n k : Nat) (h : Prf (Eq n (add k k))) : Prf (Even n)
  := exists_intro (fun (k : Nat) => Eq n (add k k)) k h;
theorem odd_elim (n : Nat) (P : Prop) (h : Prf (Odd n))
  (use : forall (k : Nat), Prf (Eq n (succ (add k k))) -> Prf P) : Prf P
  := exists_elim (fun (k : Nat) => Eq n (succ (add k k))) P h use;
theorem odd_intro (n k : Nat) (h : Prf (Eq n (succ (add k k)))) : Prf (Odd n)
  := exists_intro (fun (k : Nat) => Eq n (succ (add k k))) k h;
