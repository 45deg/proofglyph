// Peano arithmetic with successor injectivity proved from primitive recursion.
// The imported core contains induction, equality and successor disjointness.
// Recursion supplies a left inverse to successor, so injectivity needs no axiom.

import "recursion.ht";

theorem succ_injective (a b : Nat) (h : Prf (Eq (succ a) (succ b))) : Prf (Eq a b) :=
  eq_subst (fun (x : Nat) => Eq a x)
    (nat_rec zero (fun (k r : Nat) => k) (succ b)) b
    (nat_rec_succ zero (fun (k r : Nat) => k) b)
    (eq_subst (fun (x : Nat) => Eq x (nat_rec zero (fun (k r : Nat) => k) (succ b)))
      (nat_rec zero (fun (k r : Nat) => k) (succ a)) a
      (nat_rec_succ zero (fun (k r : Nat) => k) a)
      (eq_subst (fun (x : Nat) => Eq (nat_rec zero (fun (k r : Nat) => k) (succ a))
          (nat_rec zero (fun (k r : Nat) => k) x))
        (succ a) (succ b) h
        (eq_refl (nat_rec zero (fun (k r : Nat) => k) (succ a)))));
