// Inference rules of equality on the domain U.
// Eq is predicate vocabulary; eq_refl is reflexivity and eq_subst is substitution.
// Symmetry and transitivity are proved separately.

import "quantifiers.ht";

symbol Eq : U -> U -> Prop;

axiom eq_refl (a : U) : Prf (Eq a a);

axiom eq_subst (P : U -> Prop) (a b : U)
  : Prf (Eq a b) -> Prf (P a) -> Prf (P b);
