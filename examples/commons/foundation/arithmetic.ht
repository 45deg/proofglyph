// Definitions of arithmetic by primitive recursion.
// Every equation below is proved from the two number-recursion axioms.

import "peano.ht";

def add (a b : Nat) : Nat := nat_rec b (fun (n r : Nat) => succ r) a;
def mul (a b : Nat) : Nat := nat_rec zero (fun (n r : Nat) => add b r) a;
def pow (a n : Nat) : Nat := nat_rec (succ zero) (fun (k r : Nat) => mul a r) n;
def pred (n : Nat) : Nat := nat_rec zero (fun (k r : Nat) => k) n;

theorem add_succ (a b : Nat) : Prf (Eq (add (succ a) b) (succ (add a b)))
  := nat_rec_succ b (fun (n r : Nat) => succ r) a;
theorem add_zero (b : Nat) : Prf (Eq (add zero b) b)
  := nat_rec_zero b (fun (n r : Nat) => succ r);
theorem pow_zero (a : Nat) : Prf (Eq (pow a zero) (succ zero))
  := nat_rec_zero (succ zero) (fun (k r : Nat) => mul a r);
theorem pow_succ (a n : Nat) : Prf (Eq (pow a (succ n)) (mul a (pow a n)))
  := nat_rec_succ (succ zero) (fun (k r : Nat) => mul a r) n;
theorem mul_zero (b : Nat) : Prf (Eq (mul zero b) zero)
  := nat_rec_zero zero (fun (n r : Nat) => add b r);
theorem mul_succ (a b : Nat) : Prf (Eq (mul (succ a) b) (add b (mul a b)))
  := nat_rec_succ zero (fun (n r : Nat) => add b r) a;
theorem pred_succ (n : Nat) : Prf (Eq (pred (succ n)) n)
  := nat_rec_succ zero (fun (k r : Nat) => k) n;
theorem pred_zero : Prf (Eq (pred zero) zero)
  := nat_rec_zero zero (fun (k r : Nat) => k);
