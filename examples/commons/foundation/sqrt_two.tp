// Trusted vocabulary, inference rules and explicit definitions.
import "order.tp";

// Vocabulary declaration; the defining rules are in separate theory files.
axiom RationalRootTwo : Prop;

// Introduction/elimination rule for the explicit predicate definition.
axiom rational_root_two_elim (P : Prop) : Prf RationalRootTwo
  -> (forall (a b : Nat), Prf (Lt zero b) -> Prf (Eq (mul a a) (mul (succ (succ zero)) (mul b b))) -> Prf P)
    -> Prf P;

// Introduction/elimination rule for the explicit predicate definition.
axiom rational_root_two_intro (a b : Nat) : Prf (Lt zero b)
  -> Prf (Eq (mul a a) (mul (succ (succ zero)) (mul b b))) -> Prf RationalRootTwo;
