// Axiom schema of separation for the set-theory demo.
// U is the domain of sets; Mem x u means x belongs to u.
// Implication and its primitive rules are imported from logic.ht.
// separation asserts a subset of u containing exactly the elements satisfying P.
// The predicate parameter represents the schema; this is not unrestricted
// comprehension, and no global function choosing the subset is assumed.

import "quantifiers.ht";

symbol Mem : U -> U -> Prop;

axiom separation (u : U) (P : U -> Prop)
  : Prf (Exists (fun (r : U) => All (fun (x : U) => And
      (Imp (Mem x r) (And (Mem x u) (P x)))
      (Imp (And (Mem x u) (P x)) (Mem x r)))));
