// Definitions of natural-number order; no order-specific axioms.
// Definitions are expanded by Hieratic; every theorem is checked by the kernel.

import "arithmetic.ht";
import "nat_logic.ht";

def Lt (a b : Nat) : Prop := Exists (fun (k : Nat) => Eq b (add a (succ k)));
def Le (a b : Nat) : Prop := Exists (fun (k : Nat) => Eq b (add a k));

theorem lt_intro (a b k : Nat) (h : Prf (Eq b (add a (succ k)))) : Prf (Lt a b)
  := exists_intro (fun (k : Nat) => Eq b (add a (succ k))) k h;
theorem lt_elim (a b : Nat) (P : Prop) (h : Prf (Lt a b))
  (use : forall (k : Nat), Prf (Eq b (add a (succ k))) -> Prf P) : Prf P
  := exists_elim (fun (k : Nat) => Eq b (add a (succ k))) P h use;
theorem le_elim (a b : Nat) (P : Prop) (h : Prf (Le a b))
  (use : forall (k : Nat), Prf (Eq b (add a k)) -> Prf P) : Prf P
  := exists_elim (fun (k : Nat) => Eq b (add a k)) P h use;
theorem le_intro (a b k : Nat) (h : Prf (Eq b (add a k))) : Prf (Le a b)
  := exists_intro (fun (k : Nat) => Eq b (add a k)) k h;
