// Definitions of sums, factorial and triangular numbers by recursion.
// Bounded recursion has three axioms (base, inside and outside the lower bound).
// All named summation/factorial/triangular equations below are proved.

import "order.ht";

symbol bounded_rec : Nat -> Nat -> (Nat -> Nat -> Nat) -> Nat -> Nat;
axiom bounded_rec_zero (lo z : Nat) (step : Nat -> Nat -> Nat)
  : Prf (Eq (bounded_rec lo z step zero) z);
axiom bounded_rec_inside (lo z : Nat) (step : Nat -> Nat -> Nat) (n : Nat)
  : Prf (Lt lo n) -> Prf (Eq (bounded_rec lo z step (succ n)) (step n (bounded_rec lo z step n)));
axiom bounded_rec_outside (lo z : Nat) (step : Nat -> Nat -> Nat) (n : Nat)
  : Prf (Not (Lt lo n)) -> Prf (Eq (bounded_rec lo z step (succ n)) (bounded_rec lo z step n));

def sum (n : Nat) (f : Nat -> Nat) : Nat := nat_rec zero (fun (k r : Nat) => add r (f k)) n;
def sum_between (lo hi : Nat) (f : Nat -> Nat) : Nat
  := bounded_rec lo zero (fun (k r : Nat) => add r (f k)) hi;
def factorial (n : Nat) : Nat := nat_rec (succ zero) (fun (k r : Nat) => mul (succ k) r) n;
def triangular (n : Nat) : Nat := nat_rec zero (fun (k r : Nat) => add r (succ k)) n;

theorem sum_succ (n : Nat) (f : Nat -> Nat) : Prf (Eq (sum (succ n) f) (add (sum n f) (f n)))
  := nat_rec_succ zero (fun (k r : Nat) => add r (f k)) n;
theorem sum_between_succ_inside (lo hi : Nat) (f : Nat -> Nat)
  : Prf (Lt lo hi) -> Prf (Eq (sum_between lo (succ hi) f) (add (sum_between lo hi f) (f hi)))
  := bounded_rec_inside lo zero (fun (k r : Nat) => add r (f k)) hi;
theorem sum_between_succ_outside (lo hi : Nat) (f : Nat -> Nat)
  : Prf (Not (Lt lo hi)) -> Prf (Eq (sum_between lo (succ hi) f) (sum_between lo hi f))
  := bounded_rec_outside lo zero (fun (k r : Nat) => add r (f k)) hi;
theorem sum_between_zero (lo : Nat) (f : Nat -> Nat) : Prf (Eq (sum_between lo zero f) zero)
  := bounded_rec_zero lo zero (fun (k r : Nat) => add r (f k));
theorem sum_zero (f : Nat -> Nat) : Prf (Eq (sum zero f) zero)
  := nat_rec_zero zero (fun (k r : Nat) => add r (f k));
theorem factorial_succ (n : Nat) : Prf (Eq (factorial (succ n)) (mul (succ n) (factorial n)))
  := nat_rec_succ (succ zero) (fun (k r : Nat) => mul (succ k) r) n;
theorem factorial_zero : Prf (Eq (factorial zero) (succ zero))
  := nat_rec_zero (succ zero) (fun (k r : Nat) => mul (succ k) r);
theorem triangular_succ (n : Nat) : Prf (Eq (triangular (succ n)) (add (triangular n) (succ n)))
  := nat_rec_succ zero (fun (k r : Nat) => add r (succ k)) n;
theorem triangular_zero : Prf (Eq (triangular zero) zero)
  := nat_rec_zero zero (fun (k r : Nat) => add r (succ k));
