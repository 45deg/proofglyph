// Trusted vocabulary, inference rules and explicit definitions.
import "arithmetic.tp";

// Vocabulary declaration; the defining rules are in separate theory files.
axiom Lt : Nat -> Nat -> Prop;

// Introduction/elimination rule for the explicit predicate definition.
axiom lt_intro (a b k : Nat) : Prf (Eq b (add a (succ k))) -> Prf (Lt a b);

// Introduction/elimination rule for the explicit predicate definition.
axiom lt_elim (a b : Nat) (P : Prop) : Prf (Lt a b)
  -> (forall (k : Nat), Prf (Eq b (add a (succ k))) -> Prf P) -> Prf P;

// Vocabulary declaration; the defining rules are in separate theory files.
axiom Le : Nat -> Nat -> Prop;

// Introduction/elimination rule for the explicit predicate definition.
axiom le_elim (a b : Nat) (P : Prop) : Prf (Le a b)
  -> (forall (k : Nat), Prf (Eq b (add a k)) -> Prf P) -> Prf P;

// Introduction/elimination rule for the explicit predicate definition.
axiom le_intro (a b k : Nat) : Prf (Eq b (add a k)) -> Prf (Le a b);
