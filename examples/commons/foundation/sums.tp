// Trusted vocabulary, inference rules and explicit definitions.
import "order.tp";

// Vocabulary declaration; the defining rules are in separate theory files.
axiom sum_between : Nat -> Nat -> (Nat -> Nat) -> Nat;

// Vocabulary declaration; the defining rules are in separate theory files.
axiom sum : Nat -> (Nat -> Nat) -> Nat;

// Primitive-recursive defining equation; not an arithmetic lemma.
axiom sum_succ (n : Nat) (f : Nat -> Nat) : Prf (Eq (sum (succ n) f) (add (sum n f) (f n)));

// Primitive-recursive defining equation; not an arithmetic lemma.
axiom sum_between_succ_inside (lo hi : Nat) (f : Nat -> Nat) : Prf (Lt lo hi) -> Prf (Eq (sum_between lo
    (succ hi) f) (add (sum_between lo hi f) (f hi)));

// Primitive-recursive defining equation; not an arithmetic lemma.
axiom sum_between_succ_outside (lo hi : Nat) (f : Nat -> Nat) : Prf (Not (Lt lo hi)) -> Prf (Eq (sum_between
    lo (succ hi) f) (sum_between lo hi f));

// Primitive-recursive defining equation; not an arithmetic lemma.
axiom sum_between_zero (lo : Nat) (f : Nat -> Nat) : Prf (Eq (sum_between lo zero f) zero);

// Primitive-recursive defining equation; not an arithmetic lemma.
axiom sum_zero (f : Nat -> Nat) : Prf (Eq (sum zero f) zero);

// Vocabulary declaration; the defining rules are in separate theory files.
axiom factorial : Nat -> Nat;

// Primitive-recursive defining equation; not an arithmetic lemma.
axiom factorial_succ (n : Nat) : Prf (Eq (factorial (succ n)) (mul (succ n) (factorial n)));

// Primitive-recursive defining equation; not an arithmetic lemma.
axiom factorial_zero : Prf (Eq (factorial zero) (succ zero));

// Vocabulary declaration; the defining rules are in separate theory files.
axiom triangular : Nat -> Nat;

// Primitive-recursive defining equation; not an arithmetic lemma.
axiom triangular_succ (n : Nat)
  : Prf (Eq (triangular (succ n)) (add (triangular n) (succ n)));

// Primitive-recursive defining equation; not an arithmetic lemma.
axiom triangular_zero : Prf (Eq (triangular zero) zero);
