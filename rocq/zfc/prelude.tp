// Initial ZFC fragment. No Separation/Replacement schema is claimed yet.
// U is the domain of sets. All primitives below are opaque.
import "../../examples/commons/foundation/equality.tp";
import "../../examples/commons/foundation/classical.tp";

axiom Mem : U -> U -> Prop;

// Extensionality, with the two directions of membership equivalence explicit.
axiom set_ext (a b : U)
  : (forall (x : U), Prf (Mem x a) -> Prf (Mem x b))
  -> (forall (x : U), Prf (Mem x b) -> Prf (Mem x a))
  -> Prf (Eq a b);

// Existence form, without assuming a global choice of constructors.
axiom empty_exists : Prf (Exists (fun (a : U) => All (fun (x : U) => Not (Mem x a))));

axiom pair_exists (a b : U)
  : Prf (Exists (fun (p : U) => And
      (All (fun (x : U) => Or (Not (Mem x p)) (Or (Eq x a) (Eq x b))))
      (And (Mem a p) (Mem b p))));
