theorem proof_eq_reflexive : Derives zero nil (All (Equal zero zero))
  := nd_all_intro zero nil nil (Equal zero zero) lifts_nil
    (nd_eq_refl (succ zero) nil zero (lt_zero zero));
theorem proof_identity : Derives zero nil (Implies bottom bottom)
  := nd_imp_intro zero nil bottom bottom (scoped_bottom zero)
    (nd_assume zero (cons bottom nil) bottom (scoped_bottom zero) (in_here bottom nil));
