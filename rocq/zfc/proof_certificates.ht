// Renaming under a binder preserves its bound variable and lifts the map.
theorem proof_renaming_binder
  : Renames sep_map (All (Member zero (succ (succ zero))))
    (All (Member zero (succ (succ (succ (succ zero))))))
  := rename_all sep_map (Member zero (succ (succ zero)))
    (Member zero (succ (succ (succ (succ zero)))))
    (rename_member (up_map sep_map) zero (succ (succ zero))
      zero (succ (succ (succ (succ zero))))
      (maps_up_zero sep_map)
      (maps_up_succ sep_map (succ zero) (succ (succ (succ zero))) (maps_sep_succ zero)));
