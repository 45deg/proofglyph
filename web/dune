(executable
 (name browser)
 (modules browser examples_data)
 (modes js)
 (libraries proofglyph_core proofglyph_language proofglyph_hieratic js_of_ocaml))

(rule
 (targets index.html app.js math.js i18n.js translations.js worker.js worker-client.js catalog.json)
 (deps index.source.html app.source.js math.source.js i18n.source.js translations.source.js worker.source.js worker-client.source.js ../examples/catalog.json)
 (action
  (progn
   (copy index.source.html index.html)
   (copy app.source.js app.js)
   (copy math.source.js math.js)
   (copy i18n.source.js i18n.js)
   (copy translations.source.js translations.js)
   (copy worker.source.js worker.js)
   (copy worker-client.source.js worker-client.js)
   (copy ../examples/catalog.json catalog.json))))

(alias
 (name browser)
 (deps browser.bc.js index.html app.js math.js i18n.js translations.js worker.js worker-client.js catalog.json))

(executable
 (name bundle_examples)
 (modules bundle_examples)
 (libraries proofglyph_hieratic str))

(rule
 (targets examples_data.ml)
 (deps (source_tree ../examples))
 (action (with-stdout-to %{targets} (run %{exe:bundle_examples.exe}))))
